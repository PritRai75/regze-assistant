  "review": {
    "q011": {
      "facts": "different",
      "note": "New adds the furnished-card comment (12(b)(1)(ii)-3) and the $50 cap; first's definition fact is only folded into new fact 1. Both agree authority is a state-law question."
    },
    "q012": {
      "facts": "different",
      "note": "Added only: new fact 3 (notice timely). The two deadline facts and dates match."
    },
    "q013": {
      "facts": "different",
      "note": "Added only: new fact 2 (good-faith attempt, over $50, same state or 100 miles). The other two facts match."
    },
    "q014": {
      "facts": "different",
      "note": "Substantive: first uses 10 business days (12 Nov 2026), new uses the new-account 20 business days (27 Nov 2026). The 90-day date matches."
    },
    "q015": {
      "facts": "different",
      "note": "Facts 1-2 match. Fact 3 is narrower in new: comment 52(a)(2)-4 exempts reissuing a lost or stolen card, not every card-replacement fee."
    },
    "q017": {
      "facts": "different",
      "note": "First says the entire $400 goes to the purchase balance; new says first to it, remainder to the 0% balance (balances not given). New adds the minimum-payment fact."
    },
    "q019": {
      "facts": "different",
      "note": "Both state the three-business-day oral-or-written rule. New drops the 14-day written-confirmation fact and adds that her 4 Nov call is in time."
    },
    "q021": {
      "facts": "different",
      "note": "Same conclusions. New adds one-fee-a-month and disclosure conditions, splits card vs funds expiration, and drops the explicit 'neither term permitted' fact."
    },
    "q022": {
      "facts": "same",
      "note": "Wording only."
    },
    "q025": {
      "facts": "same",
      "note": ""
    },
    "q026": {
      "facts": "same",
      "note": ""
    },
    "q027": {
      "facts": "different",
      "note": "Added only: new fact 2 (no fee caps from that rule), which restates fact 1's consequence; first's reference says the same. Otherwise matches."
    },
    "q029": {
      "facts": "same",
      "note": ""
    },
    "q030": {
      "facts": "different",
      "note": "First: limits come from separate federal law outside the corpus. New names the SCRA and its 6% cap, detail the corpus cannot support."
    }
